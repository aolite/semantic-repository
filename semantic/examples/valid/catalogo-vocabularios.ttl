# Ejemplo VÁLIDO (decisión 50): catálogo con un esquema de dominio, uno
# corporativo y una ontología propia (dcat:resource). Ficticio.
# Las formas que aplica están en semantic/shapes/. Ver semantic/uris.md,
# «Vocabularios y ontologías en los catálogos».

# BASE_URI: el fichero no declara @base; las URIs son relativas.

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<catalogo/prueba>
    a dcat:Catalog ;
    dct:title "Catálogo de prueba"@es ;
    dct:description "Catálogo mínimo para probar las formas."@es ;
    dct:publisher _:unidad ;
    dcat:resource <vocab/ejemplo> ,
        <vocab/corp/ejemplo> ,
        <onto/ejemplo> .

_:unidad
    a foaf:Agent , prov:Agent ;
    foaf:name "Agente de prueba" .
