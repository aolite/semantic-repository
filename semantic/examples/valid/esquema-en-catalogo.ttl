# Ejemplo VÁLIDO (decisión 50): esquema SKOS de dominio tal como se ingesta,
# con el triple de pertenencia a su catálogo que añade el backend. El concepto
# B está retirado con owl:deprecated: conserva su URI y su lugar en el árbol.
# Esquema, conceptos y catálogo son ficticios, solo para el ejemplo.
# Las formas que aplica están en semantic/shapes/. Ver semantic/uris.md,
# «Vocabularios y ontologías en los catálogos».

# BASE_URI: el fichero no declara @base; las URIs son relativas.

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<vocab/ejemplo>
    a skos:ConceptScheme ;
    dct:title "Esquema de ejemplo"@es ;
    dct:description "Esquema mínimo para un ejemplo."@es ;
    dct:subject <vocab/dominio/ot> ;
    owl:versionInfo "1.0" ;
    adms:status <http://purl.org/adms/status/Completed> ;
    vann:preferredNamespacePrefix "ej" ;
    vann:preferredNamespaceUri <vocab/ejemplo/> ;
    skos:hasTopConcept <vocab/ejemplo/a> .

<vocab/ejemplo/a>
    a skos:Concept ;
    skos:inScheme <vocab/ejemplo> ;
    skos:topConceptOf <vocab/ejemplo> ;
    skos:prefLabel "Concepto A"@es .

<vocab/ejemplo/b>
    a skos:Concept ;
    skos:inScheme <vocab/ejemplo> ;
    skos:broader <vocab/ejemplo/a> ;
    skos:prefLabel "Concepto B"@es ;
    owl:deprecated true .

# Pertenencia a un catálogo (decisión 50): en la ingesta, el backend añade este
# triple a partir del catálogo elegido.
<catalogo/prueba> dcat:resource <vocab/ejemplo> .
