# Ejemplo INVÁLIDO (decisión 50): el número de sustitución de una versión de
# ontología externa no es un entero positivo (0).
# Todo lo demás es válido, así que solo deben fallar las formas indicadas.
# validate.py lee las líneas «expect-violation» (nombre local en {BASE_URI}shapes#).
# expect-violation: ExternalVersionShape
# expect-violation: ExternalVersion-version

# BASE_URI: el fichero no declara @base; las URIs propias son relativas. La
# IRI oficial de la ontología es ficticia (example.org) y la fecha, también.

@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<onto/externas/ejemplo/0>
    a prov:Entity ;
    dct:isVersionOf <http://example.org/ontologia-externa> ;
    dcat:version "0" ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    adms:versionNotes "Sustitución de ejemplo."@es .
