# Ejemplo INVÁLIDO (decisión 50): Ontología externa dentro de un catálogo.
# Todo lo demás es válido, así que solo deben fallar las formas indicadas.
# validate.py lee las líneas «expect-violation» (nombre local en {BASE_URI}shapes#).
# expect-violation: ExternalOntologyCatalogShape

# BASE_URI: el fichero no declara @base; las URIs son relativas.

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/ontologia-externa>
    a owl:Ontology ;
    dct:title "Ontología externa de ejemplo"@es .

# Pertenencia a un catálogo (decisión 50): en la ingesta, el backend añade este
# triple a partir del catálogo elegido.
<catalogo/prueba> dcat:resource <http://example.org/ontologia-externa> .
