# Ejemplo INVÁLIDO: Serie que pertenece a dos catálogos (regla propia, decisión 49).
# Todo lo demás es válido, así que solo debe fallar la forma indicada.
# validate.py lee las líneas «expect-violation» (nombre local en {BASE_URI}shapes#).
# expect-violation: DatasetSeries-catalog

@prefix itotd: <dataset/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix adms:  <http://www.w3.org/ns/adms#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

itotd:prueba
    a dcat:DatasetSeries ;
    dct:title "Serie de prueba"@es ;
    dct:description "Serie mínima para probar las formas."@es ;
    dcat:last <dataset/prueba/1.0.0> .

<dataset/prueba/1.0.0>
    a dcat:Dataset ;
    dct:title "Serie de prueba"@es ;
    dct:description "Versión mínima para probar las formas."@es ;
    dcat:version "1.0.0" ;
    dcat:inSeries itotd:prueba ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcat:distribution <dataset/prueba/1.0.0/csv> .

<dataset/prueba/1.0.0/csv>
    a dcat:Distribution ;
    dcat:accessURL <dataset/prueba/1.0.0/csv> ;
    dcat:mediaType <http://www.iana.org/assignments/media-types/text/csv> .

<catalogo/prueba> dcat:dataset itotd:prueba .
<catalogo/otro> dcat:dataset itotd:prueba .
