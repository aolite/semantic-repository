# Ejemplo INVÁLIDO (decisión 50): catálogo que lista el grafo de las ontologías
# externas ({BASE_URI}onto/externas) como si fuera una ontología propia.
# Todo lo demás es válido, así que solo deben fallar las formas indicadas.
# validate.py lee las líneas «expect-violation» (nombre local en {BASE_URI}shapes#).
# expect-violation: Catalog-resource

# BASE_URI: el fichero no declara @base; las URIs propias son relativas. La
# IRI oficial de la ontología es ficticia (example.org) y la fecha, también.

@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<catalogo/prueba>
    a dcat:Catalog ;
    dct:title "Catálogo de prueba"@es ;
    dct:description "Catálogo mínimo para probar las formas."@es ;
    dct:publisher _:unidad ;
    dcat:resource <onto/externas> .

_:unidad
    a foaf:Agent , prov:Agent ;
    foaf:name "Agente de prueba" .
