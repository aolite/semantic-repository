# Ejemplo INVÁLIDO (decisión 50): Catálogo que lista un esquema auxiliar (vocab/dominio).
# Todo lo demás es válido, así que solo deben fallar las formas indicadas.
# validate.py lee las líneas «expect-violation» (nombre local en {BASE_URI}shapes#).
# expect-violation: Catalog-resource

# BASE_URI: el fichero no declara @base; las URIs son relativas.

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<catalogo/prueba>
    a dcat:Catalog ;
    dct:title "Catálogo de prueba"@es ;
    dct:description "Catálogo mínimo para probar las formas."@es ;
    dct:publisher _:unidad ;
    dcat:resource <vocab/dominio> .

_:unidad
    a foaf:Agent , prov:Agent ;
    foaf:name "Agente de prueba" .
