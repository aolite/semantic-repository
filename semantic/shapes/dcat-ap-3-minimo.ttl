# Formas SHACL mínimas: propiedades OBLIGATORIAS de DCAT-AP 3.
#
# Solo recoge las cardinalidades mínimas que DCAT-AP 3 marca como obligatorias
# para las clases que usa el catálogo (Dataset, DatasetSeries, Distribution y,
# desde la decisión 49, Catalog). Lo recomendado y lo opcional de
# DCAT-AP 3 no se comprueba aquí. Las reglas propias de la unidad están en
# itot-reglas.ttl.
#
# Este fichero no declara @base: se lee pasando BASE_URI como IRI base
# (ver semantic/uris.md). Las formas quedan en {BASE_URI}shapes#.

@prefix itsh: <shapes#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# --- dcat:Dataset -----------------------------------------------------------
# DCAT-AP 3: dct:title y dct:description son obligatorias (1..n).
itsh:DatasetShape
    a sh:NodeShape ;
    rdfs:label "DCAT-AP 3 · Dataset (obligatorias)"@es ;
    sh:targetClass dcat:Dataset ;
    sh:property itsh:Dataset-title , itsh:Dataset-description .

itsh:Dataset-title
    a sh:PropertyShape ;
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:message "DCAT-AP 3: un dcat:Dataset necesita al menos un dct:title."@es .

itsh:Dataset-description
    a sh:PropertyShape ;
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:message "DCAT-AP 3: un dcat:Dataset necesita al menos una dct:description."@es .

# --- dcat:DatasetSeries -----------------------------------------------------
# DCAT-AP 3: dct:title y dct:description son obligatorias (1..n).
itsh:DatasetSeriesShape
    a sh:NodeShape ;
    rdfs:label "DCAT-AP 3 · Dataset Series (obligatorias)"@es ;
    sh:targetClass dcat:DatasetSeries ;
    sh:property itsh:DatasetSeries-title , itsh:DatasetSeries-description .

itsh:DatasetSeries-title
    a sh:PropertyShape ;
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:message "DCAT-AP 3: una dcat:DatasetSeries necesita al menos un dct:title."@es .

itsh:DatasetSeries-description
    a sh:PropertyShape ;
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:message "DCAT-AP 3: una dcat:DatasetSeries necesita al menos una dct:description."@es .

# --- dcat:Distribution ------------------------------------------------------
# DCAT-AP 3: dcat:accessURL es obligatoria (1..n).
itsh:DistributionShape
    a sh:NodeShape ;
    rdfs:label "DCAT-AP 3 · Distribution (obligatorias)"@es ;
    sh:targetClass dcat:Distribution ;
    sh:property itsh:Distribution-accessURL .

itsh:Distribution-accessURL
    a sh:PropertyShape ;
    sh:path dcat:accessURL ;
    sh:minCount 1 ;
    sh:message "DCAT-AP 3: una dcat:Distribution necesita al menos un dcat:accessURL."@es .

# --- dcat:Catalog -----------------------------------------------------------
# DCAT-AP 3: dct:title, dct:description y dct:publisher son obligatorias
# (decisión 49: varios catálogos). dcat:dataset no es obligatoria en DCAT-AP 3,
# así que un catálogo recién creado y todavía vacío cumple las formas.
itsh:CatalogShape
    a sh:NodeShape ;
    rdfs:label "DCAT-AP 3 · Catalogue (obligatorias)"@es ;
    sh:targetClass dcat:Catalog ;
    sh:property itsh:Catalog-title , itsh:Catalog-description , itsh:Catalog-publisher .

itsh:Catalog-title
    a sh:PropertyShape ;
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:message "DCAT-AP 3: un dcat:Catalog necesita al menos un dct:title."@es .

itsh:Catalog-description
    a sh:PropertyShape ;
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:message "DCAT-AP 3: un dcat:Catalog necesita al menos una dct:description."@es .

# DCAT-AP 3 la marca 1..1. El agente no tiene URI todavía (semantic/uris.md,
# «Pendiente»), así que se admite un nodo en blanco.
itsh:Catalog-publisher
    a sh:PropertyShape ;
    sh:path dct:publisher ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:message "DCAT-AP 3: un dcat:Catalog necesita exactamente un dct:publisher (un agente, no un literal)."@es .
