# Copia este fichero a .env (cp .env.example .env) y cambia los valores.
# .env está en .gitignore: no lo subas nunca. Todos los valores de aquí son ficticios.

# URIs
BASE_URI=https://semantic.example.org/itot/

# PostgreSQL (usuarios y auditoría)
POSTGRES_USER=itot
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=itot
# Debe usar los mismos usuario y contraseña de arriba
DATABASE_URL=postgresql+psycopg://itot:change-me-postgres@postgres:5432/itot

# Fuseki (triplestore). El dataset TDB2 persistente se crea al arrancar.
# Las consultas son anónimas; las escrituras exigen el usuario admin (ver infra/README.md).
FUSEKI_URL=http://fuseki:3030
FUSEKI_DATASET=itot
# Evita los caracteres / & \ en esta contraseña (la imagen la aplica con sed)
FUSEKI_ADMIN_PASSWORD=change-me-fuseki
# Usuario con el que el backend escribe en Fuseki. Su contraseña (FUSEKI_PASSWORD) no se
# define aquí: docker-compose.yml la toma de FUSEKI_ADMIN_PASSWORD.
FUSEKI_USER=admin

# Datos semánticos (formas SHACL y datos de ejemplo). En Compose se monta ./semantic en
# /semantic (solo lectura) y esta variable se fija a ese valor; cámbiala solo fuera de Compose.
SEMANTIC_DIR=/semantic

# URL pública del frontend: el backend redirige a la ficha del dataset con 303 hacia ella.
# Si cambias FRONTEND_HOST_PORT, ajústala.
FRONTEND_BASE_URL=http://localhost:5173

# Autenticación JWT. Mínimo 32 caracteres. Genera el secreto con: openssl rand -hex 32 (da 64)
# Vacío a propósito: el backend no arranca sin un secreto real.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (orígenes separados por comas)
CORS_ORIGINS=http://localhost:5173

# Almacenamiento de distribuciones (en el MVP, disco)
STORAGE_BACKEND=disk
STORAGE_DISK_PATH=/data/distributions

# Frontend
VITE_API_BASE_URL=http://localhost:8000
# Mismo valor que BASE_URI
VITE_BASE_URI=https://semantic.example.org/itot/

# Puertos publicados en el host (opcionales; solo 127.0.0.1). Descomenta si alguno está ocupado.
# Si cambias BACKEND_HOST_PORT, ajusta también VITE_API_BASE_URL (la usa el navegador).
# POSTGRES_HOST_PORT=5432
# FUSEKI_HOST_PORT=3030
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173
