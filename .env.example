# Copia este fichero a .env (cp .env.example .env) y cambia los valores.
# .env está en .gitignore: no lo subas nunca. Todos los valores de aquí son ficticios.

# URIs
BASE_URI=https://semantic.example.org/itot/

# PostgreSQL (usuarios y auditoría)
POSTGRES_USER=itot
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=itot
# Debe usar los mismos usuario y contraseña de arriba
DATABASE_URL=postgresql+psycopg://itot:change-me-postgres@postgres:5432/itot

# Fuseki (triplestore). El dataset TDB2 persistente se crea al arrancar.
# Las consultas son anónimas; las escrituras exigen el usuario backend o admin (ver infra/README.md).
FUSEKI_URL=http://fuseki:3030
FUSEKI_DATASET=itot
# Administración de Fuseki (usuario admin). Ni esta contraseña ni la siguiente pueden llevar
# , = \ # ni ; (formato de shiro.ini); infra/fuseki/entrypoint.sh no arranca si las llevan.
FUSEKI_ADMIN_PASSWORD=change-me-fuseki
# Usuario con el que el backend escribe en Fuseki, y su contraseña. docker-compose.yml la pasa
# al backend como FUSEKI_PASSWORD.
FUSEKI_USER=backend
FUSEKI_BACKEND_PASSWORD=change-me-fuseki-backend

# F-UJI (evaluador FAIR, servicio interno sin puerto en el host).
# URL de su API desde el backend, y credenciales de la autenticación Basic de la API
# (infra/fuji/users.py las lee de estas variables).
FUJI_URL=http://fuji:1071/fuji/api/v1
FUJI_USERNAME=fuji-backend
FUJI_PASSWORD=change-me-fuji
# Tiempo máximo de una evaluación
FUJI_TIMEOUT_SECONDS=300
# Cada cuántos segundos el trabajador FAIR de la API busca evaluaciones pendientes (0 = desactivado).
FAIR_WORKER_POLL_SECONDS=10
# URL base que se pasa a F-UJI en lugar de BASE_URI. Vacío = usar BASE_URI. (En el despliegue,
# docker-compose.prod.yml la deja vacía siempre.) En local,
# F-UJI no resuelve el dominio de BASE_URI: apunta al backend por la red interna.
FAIR_TARGET_BASE_URL=http://backend:8000/

# SPARQL público (a través del backend)
SPARQL_TIMEOUT_SECONDS=10
SPARQL_MAX_ROWS=10000
# Límites de frecuencia por minuto: anónimos por IP, autenticados por usuario
SPARQL_RATE_ANON_PER_MIN=30
SPARQL_RATE_AUTH_PER_MIN=60

# Bloqueo de login: fallos permitidos por (usuario, IP) dentro de la ventana, y duración del bloqueo
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Descargas de distribuciones: validez del enlace firmado y tamaño máximo de un fichero subido
DOWNLOAD_LINK_TTL_SECONDS=60
MAX_UPLOAD_MB=512

# Consultas SPARQL guardadas por usuario
SAVED_QUERIES_MAX_PER_USER=50

# Datos semánticos (formas SHACL y datos de ejemplo). En Compose se monta ./semantic en
# /semantic (solo lectura) y esta variable se fija a ese valor; cámbiala solo fuera de Compose.
SEMANTIC_DIR=/semantic

# URL pública del frontend: el backend redirige a la ficha del dataset con 303 hacia ella.
# Si cambias FRONTEND_HOST_PORT, ajústala.
FRONTEND_BASE_URL=http://localhost:5173

# Autenticación JWT. Mínimo 32 caracteres. Genera el secreto con: openssl rand -hex 32 (da 64)
# Vacío a propósito: el backend no arranca sin un secreto real.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (orígenes separados por comas)
CORS_ORIGINS=http://localhost:5173

# Almacenamiento de distribuciones (en el MVP, disco)
STORAGE_BACKEND=disk
STORAGE_DISK_PATH=/data/distributions

# Frontend
VITE_API_BASE_URL=http://localhost:8000
# Mismo valor que BASE_URI
VITE_BASE_URI=https://semantic.example.org/itot/

# Puertos publicados en el host (opcionales; solo 127.0.0.1). Descomenta si alguno está ocupado.
# Si cambias BACKEND_HOST_PORT, ajusta también VITE_API_BASE_URL (la usa el navegador).
# POSTGRES_HOST_PORT=5432
# FUSEKI_HOST_PORT=3030
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173

# Razonador (Pellet, opcional; valores por defecto del backend). Llegan al backend por env_file.
# REASONER_TIMEOUT_SECONDS=120
# REASONER_JAVA_MEMORY_MB=1024

# Límites de ingesta (opcionales; valores por defecto del backend).
# INGEST_MAX_TRIPLES=100000
# SHACL_TIMEOUT_SECONDS=60
# Espera máxima, en segundos, del bloqueo de escritura de catálogos y datasets: si otra
# escritura no ha terminado antes, la API responde 503 y load-semantic termina con error.
CATALOG_LOCK_TIMEOUT_SECONDS=30
# SHACL_MEMORY_MB=2048

# ---------------------------------------------------------------------------------------------
# Despliegue del piloto (docker-compose.prod.yml; ver "Despliegue del piloto" en infra/README.md)
# En el despliegue BASE_URI, FRONTEND_BASE_URL, CORS_ORIGINS, VITE_API_BASE_URL y VITE_BASE_URI se
# derivan de FRONTEND_HOST y API_HOST en docker-compose.prod.yml (tienen prioridad sobre las de
# arriba): no hace falta cambiarlas. Valores ficticios: pon los hosts reales solo en el .env del
# servidor, que no se versiona.
# ---------------------------------------------------------------------------------------------
# Hosts públicos, solo el nombre (sin https:// ni barra). Frontend y API van en hosts distintos
# porque comparten rutas (/datasets/{slug}). BASE_URI será https://{API_HOST}/semanticrepository/
FRONTEND_HOST=repositorio.example.org
API_HOST=api.example.org
# `internal` = certificado de la CA interna de Caddy (solo pruebas locales). En el servidor, el
# email de contacto de Let's Encrypt (avisos de caducidad), por ejemplo admin@example.org
CADDY_TLS=internal
# Puertos del proxy en el host (en el servidor, 80 y 443; no los cambies: Let's Encrypt los exige)
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
# Tamaño máximo de petición en el proxy: RDF y JSON (>= INGEST_MAX_BYTES, 10 MiB por defecto) y
# subida de ficheros de distribución (>= MAX_UPLOAD_MB). El backend vuelve a comprobarlos.
# PROXY_MAX_BODY_RDF=11MiB
# PROXY_MAX_BODY_UPLOAD=520MiB

# Copias de seguridad (infra/scripts/backup.sh): carpeta de destino en el servidor y días de
# retención. Las lee backup.sh de este fichero (o del entorno), no los contenedores.
# BACKUP_DIR=/srv/itot-backups
# BACKUP_RETENTION_DAYS=14
# Commit desplegado, para que /health pueda informar de él: export APP_COMMIT=$(git rev-parse --short HEAD)
# antes de `docker compose ... up`. Opcional.
# APP_COMMIT=
