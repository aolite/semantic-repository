# Ejemplo INVÁLIDO: El esquema declara skos:hasTopConcept, pero el concepto no declara
# skos:topConceptOf (tiene broader, así que sigue en el árbol).
#
# expect-violation: ConceptScheme-hasTopConcept-inverse
#
# BASE_URI: el fichero no declara @base; las URIs son relativas.

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

<vocab/ejemplo>
    a skos:ConceptScheme ;
    dct:title "Esquema de ejemplo"@es ;
    dct:description "Esquema mínimo para un ejemplo inválido."@es ;
    dct:subject <vocab/dominio/ot> ;
    owl:versionInfo "1.0" ;
    adms:status <http://purl.org/adms/status/Completed> ;
    vann:preferredNamespacePrefix "ej" ;
    vann:preferredNamespaceUri <vocab/ejemplo/> ;
    skos:hasTopConcept <vocab/ejemplo/a> , <vocab/ejemplo/b> .

<vocab/ejemplo/a>
    a skos:Concept ;
    skos:inScheme <vocab/ejemplo> ;
    skos:topConceptOf <vocab/ejemplo> ;
    skos:prefLabel "Concepto A"@es .

<vocab/ejemplo/b>
    a skos:Concept ;
    skos:inScheme <vocab/ejemplo> ;
    skos:broader <vocab/ejemplo/a> ;
    skos:prefLabel "Concepto B"@es .

# Pertenencia a un catálogo (decisión 50): en la ingesta, el backend añade este
# triple a partir del catálogo elegido.
<catalogo/prueba> dcat:resource <vocab/ejemplo> .
