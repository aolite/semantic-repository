# Ontología propia SINTÉTICA «Ontología de activos y amenazas IT/OT» (itot),
# versión 1.1.0 (sustituida).
#
# Fuente: pantallas «Vocabularios y ontologías» y «Ficha de ontología» del
# prototipo. Contenido de demostración: marcado con
# dct:type <vocab/tipo-dataset/sintetico> (ver semantic/uris.md).
#
# Ontología MÍNIMA: solo las clases que nombra el prototipo y que existen en
# esta versión (activos industriales y corporativos, controladores, redes,
# sistemas de supervisión, servicios IT, zonas y conductos IEC 62443,
# amenazas y controles) y las relaciones que enuncia su descripción
# («organización en zonas y conductos», «amenazas y controles que les
# afectan»). Los nombres locales, las etiquetas en inglés y catalán, los
# rdfs:comment y las cuatro propiedades de objeto son [PROPUESTA] de
# semantico.
#
# Las cifras de métricas del prototipo (48 clases, 612 axiomas…) son de
# demostración y no se persiguen: las métricas reales las calcula el backend
# a partir de este fichero.
#
# Qué añade cada versión (notas de versión del prototipo):
# - 1.0.0: activos, amenazas y controles.
# - 1.1.0: zonas y conductos IEC 62443; etiquetas en catalán.
# - 1.2.0: clases de activos OT RTU e IED; alineamiento con D3FEND.
#
# Imports y alineamientos (prototipo):
# - owl:imports SOSA/SSN y SAREF, con su URI oficial. El prototipo no dice en
#   qué versión se añadieron; ninguna nota de versión lo menciona, así que se
#   declaran desde la 1.0.0.
# - D3FEND: el alineamiento llega en la 1.2.0.
# - MITRE ATT&CK for ICS (skos:closeMatch, vía STIX 2.1): sin identificadores
#   en el prototipo. Se OMITEN (comentados en itot:Amenaza).
#
# Placeholders del prototipo que se OMITEN: dct:creator [AUTORES],
# dct:license [LICENCIA], dct:issued y dct:modified [FECHA], repositorio
# [REPOSITORIO GIT] y la fecha de cada versión [FECHA].
#
# OWL 2 DL: las propiedades de metadatos (Dublin Core, ADMS, VANN, FOAF) se
# declaran como owl:AnnotationProperty, para que el fichero sea OWL 2 DL sin
# cargar los imports.
#
# BASE_URI: el fichero no declara @base; las URIs son relativas.
# URI de la ontología: {BASE_URI}onto/itot.
# Grafo con nombre: {BASE_URI}onto/itot/1.1.0 (su owl:versionIRI).
# Etiqueta Git: onto/itot/v1.1.0.

@prefix itot: <onto/itot#> .
@prefix ot:   <vocab/ot/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# --- Cabecera ---------------------------------------------------------------
<onto/itot>
    a owl:Ontology ;
    owl:versionIRI <onto/itot/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    owl:priorVersion <onto/itot/1.0.0> ;
    owl:imports <http://www.w3.org/ns/sosa/> , <https://saref.etsi.org/core/> ;
    dct:type <vocab/tipo-dataset/sintetico> ;
    dct:title "Ontología de activos y amenazas IT/OT"@es ;
    dct:description "Modelo conceptual de los activos de entornos industriales y corporativos (controladores, redes, sistemas de supervisión, servicios IT), su organización en zonas y conductos según IEC 62443, y las amenazas y controles que les afectan. Sirve de esquema común para los datasets de detección y los inventarios de activos de los proyectos de la unidad."@es ;
    adms:versionNotes "Zonas y conductos IEC 62443; etiquetas en catalán."@es ;
    adms:status <http://purl.org/adms/status/Completed> ;
    vann:preferredNamespacePrefix "itot" ;
    vann:preferredNamespaceUri <onto/itot#> ;
    # dct:creator [AUTORES] ;
    # dct:license [LICENCIA] ;
    # dct:issued [FECHA] ;
    # dct:modified [FECHA] ;
    # Repositorio: [REPOSITORIO GIT] ;
    # dct:subject: el prototipo solo muestra los conceptos SKOS que usa la
    # versión actual (1.2.0); para esta versión no los da.
    # dct:subject <vocab/ot/[CONCEPTO]> ;
    dct:publisher _:unidad-itot .

# El agente «Eurecat · Unidad IT&OT Security» no tiene URI en el prototipo:
# nodo en blanco (solo con foaf:name, para seguir en OWL 2 DL).
_:unidad-itot foaf:name "Eurecat · Unidad IT&OT Security" .

# --- Propiedades de anotación (metadatos) -----------------------------------
dct:title a owl:AnnotationProperty .
dct:description a owl:AnnotationProperty .
dct:type a owl:AnnotationProperty .
dct:subject a owl:AnnotationProperty .
dct:publisher a owl:AnnotationProperty .
adms:status a owl:AnnotationProperty .
adms:versionNotes a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .
foaf:name a owl:AnnotationProperty .

# --- Activos ----------------------------------------------------------------
itot:Activo
    a owl:Class ;
    rdfs:label "Activo"@es , "Asset"@en , "Actiu"@ca ;
    rdfs:comment "Activo de un entorno industrial o corporativo."@es .

itot:ActivoIndustrial
    a owl:Class ;
    rdfs:subClassOf itot:Activo ;
    rdfs:label "Activo industrial"@es , "Industrial asset"@en , "Actiu industrial"@ca ;
    rdfs:comment "Activo de un entorno industrial (OT)."@es .

itot:ActivoCorporativo
    a owl:Class ;
    rdfs:subClassOf itot:Activo ;
    rdfs:label "Activo corporativo"@es , "Corporate asset"@en , "Actiu corporatiu"@ca ;
    rdfs:comment "Activo de un entorno corporativo (IT)."@es .

itot:Controlador
    a owl:Class ;
    rdfs:subClassOf itot:ActivoIndustrial ;
    rdfs:label "Controlador"@es , "Controller"@en , "Controlador"@ca ;
    rdfs:comment "Activo industrial que lee los sensores y gobierna los actuadores del proceso."@es .

itot:SistemaSupervision
    a owl:Class ;
    rdfs:subClassOf itot:ActivoIndustrial ;
    rdfs:label "Sistema de supervisión"@es , "Supervisory system"@en , "Sistema de supervisió"@ca ;
    rdfs:comment "Sistema de supervisión y control (SCADA, HMI) de un área de proceso."@es .

itot:Red
    a owl:Class ;
    rdfs:subClassOf itot:Activo ;
    rdfs:label "Red"@es , "Network"@en , "Xarxa"@ca ;
    rdfs:comment "Red de comunicaciones de un entorno industrial o corporativo."@es .

itot:ServicioIT
    a owl:Class ;
    rdfs:subClassOf itot:ActivoCorporativo ;
    rdfs:label "Servicio IT"@es , "IT service"@en , "Servei IT"@ca ;
    rdfs:comment "Servicio de un entorno corporativo."@es .

# --- Zonas y conductos IEC 62443 (desde la 1.1.0) ---------------------------
itot:Zona
    a owl:Class ;
    rdfs:label "Zona"@es , "Zone"@en , "Zona"@ca ;
    rdfs:comment "Agrupación lógica o física de activos que comparten requisitos de seguridad, según IEC 62443."@es .

itot:Conducto
    a owl:Class ;
    rdfs:label "Conducto"@es , "Conduit"@en , "Conducte"@ca ;
    rdfs:comment "Agrupación de canales de comunicación entre zonas que comparten requisitos de seguridad, según IEC 62443."@es .

itot:perteneceAZona
    a owl:ObjectProperty ;
    rdfs:domain itot:Activo ;
    rdfs:range itot:Zona ;
    rdfs:label "pertenece a la zona"@es , "belongs to zone"@en , "pertany a la zona"@ca ;
    rdfs:comment "Relaciona un activo con la zona IEC 62443 en la que se agrupa."@es .

itot:conecta
    a owl:ObjectProperty ;
    rdfs:domain itot:Conducto ;
    rdfs:range itot:Zona ;
    rdfs:label "conecta"@es , "connects"@en , "connecta"@ca ;
    rdfs:comment "Relaciona un conducto IEC 62443 con las zonas que comunica."@es .

# --- Amenazas y controles ---------------------------------------------------
itot:Amenaza
    a owl:Class ;
    rdfs:label "Amenaza"@es , "Threat"@en , "Amenaça"@ca ;
    rdfs:comment "Amenaza que afecta a los activos."@es .
    # Alineamiento con MITRE ATT&CK for ICS (prototipo): skos:closeMatch
    # hacia técnicas ofensivas, vía STIX 2.1. Identificadores: [ID de técnica].

itot:Control
    a owl:Class ;
    rdfs:label "Control"@es , "Security control"@en , "Control"@ca ;
    rdfs:comment "Control de seguridad que se aplica a los activos frente a las amenazas."@es .

itot:afectaA
    a owl:ObjectProperty ;
    rdfs:domain itot:Amenaza ;
    rdfs:range itot:Activo ;
    rdfs:label "afecta a"@es , "affects"@en , "afecta"@ca ;
    rdfs:comment "Relaciona una amenaza con un activo al que afecta."@es .

itot:seAplicaA
    a owl:ObjectProperty ;
    rdfs:domain itot:Control ;
    rdfs:range itot:Activo ;
    rdfs:label "se aplica a"@es , "applies to"@en , "s'aplica a"@ca ;
    rdfs:comment "Relaciona un control con un activo al que se aplica."@es .
