# Servidor estático del frontend de producción (build de Vite). Solo lo alcanza el proxy
# inverso por la red interna: no publica puertos. HTTPS y cabeceras de seguridad las pone el proxy.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Los ficheros de /assets llevan hash en el nombre: se pueden cachear para siempre.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	# Rutas del React Router: cualquier ruta sin fichero devuelve index.html.
	try_files {path} /index.html
	file_server
}
