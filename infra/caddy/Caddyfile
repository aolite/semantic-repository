# Proxy inverso del despliegue del piloto (docker-compose.prod.yml).
# Es lo único que publica puertos en el host (80 y 443). Fuseki, PostgreSQL y F-UJI no se
# exponen nunca: el SPARQL público va siempre por el backend (decisión 42).
#
# Variables (las fija docker-compose.prod.yml a partir de .env):
#   FRONTEND_HOST, API_HOST    nombres de host, solo el nombre (sin esquema ni barra)
#   CADDY_TLS                  `internal` (certificado de la CA interna de Caddy, solo para
#                              pruebas locales) o el email de contacto de Let's Encrypt
#   PROXY_MAX_BODY_RDF         tamaño máximo de petición del API en general (>= INGEST_MAX_BYTES)
#   PROXY_MAX_BODY_UPLOAD      tamaño máximo de la subida de ficheros (>= MAX_UPLOAD_MB)
#
# Let's Encrypt solo emite certificados: no recibe datos del repositorio.
{
	servers {
		timeouts {
			read_header 10s
		}
	}
}

# Cabeceras comunes y registro de acceso. El enlace firmado de descarga lleva `?token=`:
# se oculta del registro, como hace el backend en el suyo (app/log_filters.py).
(comun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				replace token REDACTED
			}
		}
	}
}

# Frontend: SPA estática servida por el contenedor `frontend` (infra/frontend).
{$FRONTEND_HOST} {
	tls {$CADDY_TLS}
	import comun
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://{$API_HOST}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	request_body {
		max_size 1MiB
	}
	reverse_proxy frontend:8080
}

# API y URIs persistentes. El backend sirve en la raíz (/auth, /datasets, /sparql, /dataset/...,
# /docs...); las URIs persistentes son {BASE_URI}dataset/... con BASE_URI =
# https://{API_HOST}/semanticrepository/, así que el prefijo /semanticrepository se quita
# aquí y el resto (dataset, catalogo, onto, vocab, sparql) llega tal cual al backend.
{$API_HOST} {
	tls {$CADDY_TLS}
	import comun

	# Por defecto, una API JSON no necesita cargar nada.
	@nodocs not path /docs /docs/* /redoc /redoc/*
	header @nodocs Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

	# /docs (Swagger UI) y /redoc, públicos (decisión 24): cargan scripts y estilos de
	# cdn.jsdelivr.net y Swagger tiene un script en línea. Esta CSP más abierta solo se
	# aplica a estas rutas. No se permiten Google Fonts ni el favicon de fastapi.tiangolo.com
	# (ReDoc y Swagger los piden; sin ellos usan fuentes del sistema y sin favicon).
	@docs path /docs /docs/* /redoc /redoc/*
	header @docs Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net blob:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

	# Subida de ficheros de distribución: hasta MAX_UPLOAD_MB (el backend lo vuelve a comprobar).
	@upload {
		method PUT
		path_regexp ^/datasets/[^/]+/versions/[^/]+/distributions/[^/]+/file$
	}
	request_body @upload {
		max_size {$PROXY_MAX_BODY_UPLOAD}
	}
	# Resto de peticiones: RDF de ingesta (INGEST_MAX_BYTES), consultas SPARQL, JSON.
	@resto not {
		method PUT
		path_regexp ^/datasets/[^/]+/versions/[^/]+/distributions/[^/]+/file$
	}
	request_body @resto {
		max_size {$PROXY_MAX_BODY_RDF}
	}

	handle_path /semanticrepository/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy backend:8000
	}
}
